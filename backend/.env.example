# Database Configuration
# Get from Neon Console: https://console.neon.tech/
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-min-32-characters-change-in-production

# Application Settings
APP_ENV=development
DEBUG=true

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Phase IV: AI Chatbot
# OpenRouter API Key - Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct
MAX_CONVERSATION_HISTORY=50
