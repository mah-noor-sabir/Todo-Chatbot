# Database Configuration
# Get from Neon Console: https://console.neon.tech/
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-min-32-characters-change-in-production

# Application Settings
APP_ENV=development
DEBUG=true

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Phase IV: AI Chatbot
# OpenRouter API Key - Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4
